#!/usr/bin/env bash
# reindex — regenerate <device>/packages/INDEX.md for every package-split device
# config in this repo, from each package file's EXPOSES header.
# Reads only header lines (one grep per file), never file bodies. Output is
# deterministic (sorted) so it can be diffed reliably.
#   ./reindex          write <device>/packages/INDEX.md for every device found
#   ./reindex --print  emit all generated indexes to stdout instead of writing
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

generate_one() {
  local device="$1"
  local files
  files="$(git ls-files "$device/packages/" | grep -E '\.ya?ml$' | sort || true)"
  [ -n "$files" ] || return

  printf '# Package Index\n'
  printf '<!-- Generated by reindex. Do not edit by hand. Rebuild after adding or moving packages. -->\n'

  local domains
  domains="$(printf '%s\n' "$files" | sed -E "s#^$device/packages/([^/]+)/.*#\1#" | sort -u)"

  local d f exposes notes
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    printf '\n## %s\n' "$d"
    notes="$device/packages/$d/NOTES.md"
    git ls-files --error-unmatch "$notes" >/dev/null 2>&1 && printf 'NOTES: %s\n' "$notes"
    printf '%s\n' "$files" | grep -E "^$device/packages/$d/" | while IFS= read -r f; do
      exposes="$(grep -m1 -E '^#[[:space:]]*EXPOSES:' "$f" 2>/dev/null \
        | sed -E 's/^#[[:space:]]*EXPOSES:[[:space:]]*//' || true)"
      if [ -n "$exposes" ]; then
        printf -- '- `%s` — %s\n' "${f#$device/packages/$d/}" "$exposes"
      else
        printf -- '- `%s` — (no EXPOSES header)\n' "${f#$device/packages/$d/}"
      fi
    done
  done <<< "$domains"
}

# Discover device dirs that have a packages/ subdirectory (git-tracked).
devices="$(git ls-files -- '*/packages/*.yaml' | sed -E 's#^([^/]+)/packages/.*#\1#' | sort -u)"

if [ "${1:-}" = "--print" ]; then
  for device in $devices; do
    generate_one "$device"
    echo
  done
else
  for device in $devices; do
    out="$device/packages/INDEX.md"
    generate_one "$device" > "$out"
    echo "Wrote $out"
  done
fi
